{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASM finding",
  "type": "object",
  "required": [
    "id",
    "rule_id",
    "title",
    "category",
    "severity",
    "confidence",
    "status",
    "path",
    "line",
    "message",
    "remediation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "observed",
        "suspected",
        "needs-validation",
        "not-assessed",
        "resolved"
      ]
    },
    "path": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "cwe": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
